# Copy this file:  cp .env.example .env   then edit the values.
# .env is ignored by Git. Only this example file is committed.

# --- PostgreSQL ---
POSTGRES_USER=glowlog
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=glowlog

# --- App ---
# Port opened on localhost -> http://localhost:8000
APP_PORT=8000
# How long (seconds) GET /api/routines stays cached in Redis
CACHE_TTL_SECONDS=30

# --- Adminer (profile "tools") ---
ADMINER_PORT=8080
